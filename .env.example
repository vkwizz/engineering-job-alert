# Database Configuration
# Local Development SQLite:
DATABASE_URL=sqlite:///jobs.db
# Production Render Postgres:
# DATABASE_URL=postgresql://user:password@host:port/dbname

# OpenAI API Key (For gpt-4o-mini structured classification)
OPENAI_API_KEY=your_openai_api_key_here

# SerpApi Key (Google Jobs API discovery source)
SERPAPI_API_KEY=your_serpapi_api_key_here

# Telegram Notifications
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Email / Gmail Notifications (SMTP / Gmail API)
GMAIL_SENDER_ADDRESS=your_email@gmail.com
GMAIL_RECIPIENT_ADDRESS=your_email@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here

# Server & Scheduler Settings (For 24/7 Full-time Execution)
RUN_INTERVAL_HOURS=6
RUN_ON_STARTUP=true
MAX_QUERIES=15
GROQ_API_KEY=your_groq_api_key_here

